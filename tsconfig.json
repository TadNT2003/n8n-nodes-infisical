{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2017",
    "outDir": "dist",
    "rootDir": ".",
    "declaration": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["utils/*"]
    }
  },
  "include": [
    "credentials/**/*",
    "nodes/**/*",
    "utils/**/*"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
